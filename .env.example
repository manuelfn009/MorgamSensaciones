# Gmail — cuenta desde la que se envían los correos
# 1) Activa la verificación en 2 pasos en tu cuenta Google
# 2) Crea una contraseña de aplicación: https://myaccount.google.com/apppasswords
GMAIL_USER=tunombre@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Nombre que verá el destinatario (opcional)
FROM_EMAIL=Morgam <tunombre@gmail.com>

# Correo de la tienda donde llegan los nuevos pedidos (puede ser el mismo Gmail)
MORGAM_EMAIL=tunombre@gmail.com

# Datos bancarios para el correo al cliente (si no usas Stripe)
BANK_IBAN=ES00 0000 0000 0000 0000 0000
BANK_BENEFICIARY=Morgam
BANK_CONCEPT=

# Stripe — opcional, para pago con tarjeta (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# URL pública de la web (para enlaces de pago Stripe)
FRONTEND_URL=http://localhost:4200

# Puerto del servidor de correos
PORT=3000
